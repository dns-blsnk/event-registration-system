# Copy to .env for local development. Values below match docker-compose.yml (local only).
# Real secrets (API keys, OAuth secrets) stay empty here and live in Render / Vercel / GitHub Secrets.

NODE_ENV=development
LOG_LEVEL=debug

# API
API_PORT=3000
# Reverse proxies in front of the API (0 locally; production requires at least 1)
TRUST_PROXY_HOPS=0
# Origin of the admin app, used for CORS and the Socket.IO origin check
ADMIN_ORIGIN=http://localhost:5173

# Database (docker compose service "postgres")
DATABASE_URL=postgresql://ers:ers_local_only@localhost:5442/ers
# Integration tests (docker compose service "postgres-test")
TEST_DATABASE_URL=postgresql://ers:ers_local_only@localhost:5443/ers_test

# Session and CSRF signing secret: at least 32 random characters (openssl rand -hex 32)
SESSION_SECRET=

# S3-compatible storage (SeaweedFS locally, Cloudflare R2 in production)
S3_ENDPOINT=http://localhost:8333
S3_REGION=auto
S3_BUCKET=ers-uploads
S3_ACCESS_KEY_ID=ers_local_key
S3_SECRET_ACCESS_KEY=ers_local_only_secret
S3_FORCE_PATH_STYLE=true

# Password of the demo accounts created by `pnpm db:seed` (admin@demo.test, organizer@demo.test,
# customer@demo.test). At least 10 characters; choose your own.
SEED_DEMO_PASSWORD=

# AI chat (optional: without a key the chat shows "assistant unavailable")
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-5-5

# GitHub OAuth (optional: disabled when empty)
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
