generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  moduleFormat        = "esm"
  importFileExtension = "js"
}

datasource db {
  provider = "postgresql"
}

/// Values match the Role constants in @ers/shared.
enum Role {
  SUPER_ADMIN
  ADMIN
  ORGANIZER
  CUSTOMER
}

/// Admins, organizers and customers. Customers book seats; organizers run their own events.
model User {
  id              String         @id @default(uuid()) @db.Uuid
  /// Stored lower-cased and trimmed (CHECK constraint in the migration), so uniqueness is case-insensitive.
  email           String         @unique @db.VarChar(254)
  name            String         @db.VarChar(120)
  /// argon2id hash; null for accounts that only sign in through OAuth.
  passwordHash    String?        @map("password_hash") @db.VarChar(255)
  role            Role           @default(CUSTOMER)
  githubId        String?        @unique @map("github_id") @db.VarChar(64)
  avatarKey       String?        @map("avatar_key") @db.VarChar(512)
  createdAt       DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime       @updatedAt @map("updated_at") @db.Timestamptz(3)
  authSessions    AuthSession[]
  organizedEvents Event[]
  registrations   Registration[]
  pinnedEvents    PinnedEvent[]

  @@index([role])
  @@map("users")
}

/// Server-side session. The cookie holds a random token; only its SHA-256 is stored here.
model AuthSession {
  id         String   @id @default(uuid()) @db.Uuid
  tokenHash  String   @unique @map("token_hash") @db.Char(64)
  /// Sent to the client and echoed in X-CSRF-Token on every state-changing request.
  csrfToken  String   @map("csrf_token") @db.Char(64)
  userId     String   @map("user_id") @db.Uuid
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  lastSeenAt DateTime @default(now()) @map("last_seen_at") @db.Timestamptz(3)
  expiresAt  DateTime @map("expires_at") @db.Timestamptz(3)
  ip         String?  @db.VarChar(64)
  userAgent  String?  @map("user_agent") @db.VarChar(512)

  @@index([userId])
  @@index([expiresAt])
  @@index([lastSeenAt])
  @@map("auth_sessions")
}

/// Values match the EventStatus constants in @ers/shared.
enum EventStatus {
  DRAFT
  PUBLISHED
  COMPLETED
  CANCELLED
}

/// Values match the RegistrationStatus constants in @ers/shared.
enum RegistrationStatus {
  CONFIRMED
  WAITLISTED
  CANCELLED
  ATTENDED
}

/// An event run by one organizer. Deleting the organizer is refused while they own events.
model Event {
  id          String        @id @default(uuid()) @db.Uuid
  title       String        @db.VarChar(200)
  slug        String        @unique @db.VarChar(220)
  description String        @db.VarChar(5000)
  venue       String        @db.VarChar(200)
  city        String        @db.VarChar(100)
  startsAt    DateTime      @map("starts_at") @db.Timestamptz(3)
  endsAt      DateTime      @map("ends_at") @db.Timestamptz(3)
  status      EventStatus   @default(DRAFT)
  /// Object key of the banner image in S3 storage; null until one is uploaded.
  bannerKey   String?       @map("banner_key") @db.VarChar(512)
  organizerId String        @map("organizer_id") @db.Uuid
  organizer   User          @relation(fields: [organizerId], references: [id], onDelete: Restrict)
  createdAt   DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime      @updatedAt @map("updated_at") @db.Timestamptz(3)
  sessions    Session[]
  tags        EventTag[]
  pinnedBy    PinnedEvent[]

  @@index([status, startsAt])
  @@index([city])
  @@index([organizerId])
  @@index([startsAt])
  @@map("events")
}

/// Tag names are unique ignoring case (unique index on lower(name) in the migration).
model Tag {
  id     String     @id @default(uuid()) @db.Uuid
  name   String     @unique @db.VarChar(50)
  events EventTag[]

  @@map("tags")
}

/// Many-to-many link between events and tags.
model EventTag {
  eventId String @map("event_id") @db.Uuid
  tagId   String @map("tag_id") @db.Uuid
  event   Event  @relation(fields: [eventId], references: [id], onDelete: Cascade)
  tag     Tag    @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([eventId, tagId])
  @@index([tagId])
  @@map("event_tags")
}

/// A time slot of an event with limited seats. confirmedCount is maintained atomically
/// (conditional UPDATE) so concurrent bookings can never exceed capacity.
model Session {
  id             String         @id @default(uuid()) @db.Uuid
  eventId        String         @map("event_id") @db.Uuid
  event          Event          @relation(fields: [eventId], references: [id], onDelete: Cascade)
  title          String         @db.VarChar(200)
  speaker        String?        @db.VarChar(120)
  room           String?        @db.VarChar(80)
  startsAt       DateTime       @map("starts_at") @db.Timestamptz(3)
  endsAt         DateTime       @map("ends_at") @db.Timestamptz(3)
  capacity       Int
  confirmedCount Int            @default(0) @map("confirmed_count")
  createdAt      DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime       @updatedAt @map("updated_at") @db.Timestamptz(3)
  registrations  Registration[]

  @@index([eventId, startsAt])
  @@index([startsAt])
  @@map("sessions")
}

/// A customer's booking of a session. Effectively a many-to-many between users and sessions with
/// its own status. One row per customer and session: booking again after cancelling reuses the row.
/// Deleting a session or customer that has registrations is refused (history).
model Registration {
  id          String             @id @default(uuid()) @db.Uuid
  sessionId   String             @map("session_id") @db.Uuid
  session     Session            @relation(fields: [sessionId], references: [id], onDelete: Restrict)
  customerId  String             @map("customer_id") @db.Uuid
  customer    User               @relation(fields: [customerId], references: [id], onDelete: Restrict)
  status      RegistrationStatus
  createdAt   DateTime           @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime           @updatedAt @map("updated_at") @db.Timestamptz(3)
  cancelledAt DateTime?          @map("cancelled_at") @db.Timestamptz(3)

  @@unique([sessionId, customerId])
  /// Waitlist order: oldest WAITLISTED registration of a session is promoted first (id breaks ties).
  @@index([sessionId, status, createdAt, id])
  @@index([customerId, status])
  @@map("registrations")
}

enum LogLevel {
  WARN
  ERROR
}

enum LogCategory {
  /// 5xx responses, unhandled exceptions, AI provider failures
  ERROR
  /// Failed logins, 401/403, CSRF failures, rate limits, rejected uploads
  SECURITY
}

/// Error and security journal shown on the admin "Logs" page. Kept for 7 days.
model AppLog {
  id         String      @id @default(uuid()) @db.Uuid
  createdAt  DateTime    @default(now()) @map("created_at") @db.Timestamptz(3)
  level      LogLevel
  category   LogCategory
  requestId  String?     @map("request_id") @db.VarChar(64)
  method     String?     @db.VarChar(10)
  route      String?     @db.VarChar(512)
  statusCode Int?        @map("status_code") @db.SmallInt
  errorCode  String?     @map("error_code") @db.VarChar(64)
  message    String      @db.VarChar(2000)
  stack      String?     @db.VarChar(8000)
  /// Snapshot of the actor, no foreign key: deleting a user must not break the journal.
  userId     String?     @map("user_id") @db.Uuid
  userRole   String?     @map("user_role") @db.VarChar(16)
  ip         String?     @db.VarChar(64)
  userAgent  String?     @map("user_agent") @db.VarChar(512)
  durationMs Int?        @map("duration_ms")
  /// Allow-listed, non-sensitive fields only.
  context    Json?

  @@index([createdAt])
  @@index([requestId])
  @@index([statusCode, createdAt])
  @@index([category, createdAt])
  @@map("app_logs")
}

/// An event a staff member keeps on their dashboard. Per user; removed with the user or the event.
model PinnedEvent {
  userId    String   @map("user_id") @db.Uuid
  eventId   String   @map("event_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  event     Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@id([userId, eventId])
  @@index([eventId])
  @@map("pinned_events")
}
